# Copy to `.env` in this directory (gitignored) or `{COORDINATOR_HOME}/.env`.
# Existing process env wins; missing file is fine.

# Hermes inbound webhook (HMAC V2). Secret is env-only — never put it in config.json.
COORDINATOR_HERMES_URL=http://127.0.0.1:8644/webhooks/coordinator-failure
COORDINATOR_HERMES_SECRET=

# Opt-in phase-advance POSTs (track 0033). off | 1 | true | on
# COORDINATOR_NOTIFY_PROGRESS=on
